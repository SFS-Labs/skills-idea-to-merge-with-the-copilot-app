---
// Bookmarks component. The markup renders during the static build; all
// browser-only behavior runs in the inline client script below.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input id="url" name="url" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="https://example.com" required />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>
<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>

<script>
  const STORAGE_KEY = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const empty = document.getElementById('empty-state');
  const header = document.getElementById('list-header');
  const clear = document.getElementById('clear-all');

  function loadBookmarks() {
    try {
      const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      if (!Array.isArray(parsed)) return [];
      return parsed.filter((item) => item && typeof item.url === 'string' && typeof item.slug === 'string');
    } catch {
      return [];
    }
  }

  function saveBookmarks(bookmarks) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(bookmarks)); } catch { /* storage may be unavailable */ }
  }

  function makeSlug() {
    return `mona-${Math.random().toString(36).slice(2, 6)}`;
  }

  function render() {
    const bookmarks = loadBookmarks();
    list.replaceChildren();
    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';
      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noreferrer';
      link.textContent = bookmark.url;
      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;
      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'copy';
      copy.textContent = 'Copy';
      copy.addEventListener('click', async () => { await navigator.clipboard.writeText(bookmark.slug); copy.textContent = 'Copied'; });
      item.append(link, document.createTextNode(' :: '), slug, copy);
      list.appendChild(item);
    }
    empty.hidden = bookmarks.length > 0;
    header.hidden = bookmarks.length === 0;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const raw = input.value.trim();
    if (!raw) return;
    const url = /^https?:\/\//i.test(raw) ? raw : `https://${raw}`;
    try { new URL(url); } catch { input.setCustomValidity('Enter a valid URL'); input.reportValidity(); return; }
    const bookmarks = loadBookmarks();
    bookmarks.push({ url, slug: makeSlug() });
    saveBookmarks(bookmarks);
    form.reset();
    render();
  });

  clear?.addEventListener('click', () => {
    if (!confirm('Remove every saved bookmark?')) return;
    saveBookmarks([]);
    render();
  });

  render();
</script>
